{
  "name": "backlog-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backlog Buddy — Prepare Smart. Clear Your Backlogs. A study platform for engineering students preparing for supplementary/backlog exams.",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pdfs": "node scripts/make-pdfs.mjs && python3 scripts/generate_pdfs.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
