# ---- Supabase (never expose the service role key in the client) ----
SUPABASE_URL=https://jcltcmildaclwjkxgrgu.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: direct Postgres connection string used to create the tables
# automatically on first boot (Supabase -> Project settings -> Database).
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Google Gemini (backend only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- App ----
PORT=4000
CLIENT_URL=http://localhost:3000
# Directory used to serve the static frontend (repo root). Empty disables it.
STATIC_DIR=../
