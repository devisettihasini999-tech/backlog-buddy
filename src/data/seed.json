  "flagshipQuestions": {
    "cs301": [
      { "unit": 1, "topic": "Arrays and Linked Lists", "text": "Explain the array representation of lists. Compare array and linked list implementations with respect to memory usage and performance.", "label": "Very Important", "appearances": [2023, 2024, 2025, 2026] },
      { "unit": 1, "topic": "Arrays and Linked Lists", "text": "Write algorithms to insert and delete a node at the beginning and at the end of a singly linked list. Explain with neat diagrams.", "label": "Frequently Asked", "appearances": [2024, 2025, 2026] },
      { "unit": 1, "topic": "Arrays and Linked Lists", "text": "Differentiate between singly linked list, doubly linked list and circular linked list with suitable examples.", "label": "Repeated Question", "appearances": [2023, 2025, 2026] },
      { "unit": 2, "topic": "Stacks and Queues", "text": "Explain the stack operations (push, pop, peek) with algorithms. What are the important applications of stacks?", "label": "Very Important", "appearances": [2023, 2024, 2025, 2026] },
      { "unit": 2, "topic": "Stacks and Queues", "text": "Implement a queue using a linked list. Compare linear queue, circular queue and priority queue.", "label": "Frequently Asked", "appearances": [2024, 2025] },
